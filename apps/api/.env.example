# ==========================================
# PROPIFY CRM - CONFIGURACIÓN DEL ENTORNO
# ==========================================

# 1. Base de Datos
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/propify_db?schema=public"

# 2. Servidor Backend
PORT=3001

# 3. Meta (WhatsApp Cloud API)
# Token de acceso permanente (o temporal) generado en "Meta for Developers"
META_ACCESS_TOKEN="AQUÍ_TU_TOKEN_DE_META"

# El ID del número de teléfono (Phone Number ID) asociado a tu App de WhatsApp
META_PHONE_NUMBER_ID="AQUÍ_TU_PHONE_NUMBER_ID"

# Un token inventado por ti que debes poner tanto aquí como en el campo "Verify Token" de Meta al configurar el Webhook
META_VERIFY_TOKEN="propify_super_secreto_2024"

# 4. OpenAI (Asistentes Inteligentes)
OPENAI_API_KEY="sk-proj-AQUÍ_TU_API_KEY_DE_OPENAI"
